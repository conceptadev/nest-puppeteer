{
  "name": "@concepta/puppeteer-nest",
  "version": "0.1.0",
  "description": "Puppeteer integration for NestJS 12 with a Cloudflare Browser Rendering-style API",
  "keywords": [
    "browser",
    "headless",
    "nest",
    "nestjs",
    "nestjs-12",
    "provider",
    "puppeteer",
    "pdf",
    "screenshot",
    "scrape",
    "esm",
    "concepta"
  ],
  "license": "MIT",
  "author": "Concepta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conceptadev/nest-puppeteer.git"
  },
  "homepage": "https://github.com/conceptadev/nest-puppeteer#readme",
  "bugs": {
    "url": "https://github.com/conceptadev/nest-puppeteer/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.24.0",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs",
      "default": "./dist/core.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch src",
    "lint": "biome check src/ test/ scripts/ tsdown.config.ts",
    "lint:fix": "biome check --write src/ test/ scripts/ tsdown.config.ts",
    "format": "biome format --write src/ test/ scripts/ tsdown.config.ts",
    "format:check": "biome format src/ test/ scripts/ tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "verify:pack": "pnpm run build && publint --strict && attw --pack . --profile esm-only && node scripts/test-packed-core.mjs",
    "verify": "pnpm run check && pnpm run test && pnpm run verify:pack",
    "prepack": "pnpm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/publish.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "class-transformer": ">=0.5.1 <1",
    "class-validator": ">=0.15.1 <1",
    "puppeteer": "^25.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "3.0.2",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/multer": "2.2.0",
    "@types/node": "26.4.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "publint": "0.3.24",
    "puppeteer": "25.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
