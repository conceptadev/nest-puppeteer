{
  "name": "puppeteer-nest-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.json",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.json --testPathPatterns e2e"
  },
  "dependencies": {
    "puppeteer-nest": "file:..",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "puppeteer": "^25.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.5.0",
    "supertest": "^7.2.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0"
  }
}
